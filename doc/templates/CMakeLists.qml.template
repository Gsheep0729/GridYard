# =====================================================================
#  GridYard Qt Quick / QML 项目 CMake 样板 (多模块拆分指引版)
#  对应规范：GY-CS-002 §二、§七
#
#  在多模块项目（如 GridYard）中，本模板的功能已被拆分为三部分：
#    - 区域 [A]：全局总控与环境配置 -> 写入主目录 src/CMakeLists.txt
#    - 区域 [B]：底层公共逻辑静态库 -> 写入 src/shared/CMakeLists.txt
#    - 区域 [C]：客户端与界面注册   -> 写入 src/client/CMakeLists.txt
# =====================================================================

# =====================================================================
#  区域 [A]：全局总控与环境配置 (对应 src/CMakeLists.txt)
#  管理全局编译选项、Qt 查找以及引入子目录
# =====================================================================
cmake_minimum_required(VERSION 4.2.3)
set(CMAKE_EXPERIMENTAL_CXX_IMPORT_STD "d0edc3af-4c50-42ea-a356-e2862fe7a444")
set(CMAKE_CXX_MODULE_STD ON)

project(<<PROJECT_NAME>> VERSION 0.1 LANGUAGES CXX)

find_package(Qt6 REQUIRED COMPONENTS Quick Network QuickControls2)
qt_standard_project_setup(REQUIRES 6.10)

# 多模块总控通过 add_subdirectory 串联：
# add_subdirectory(shared)
# add_subdirectory(client)


# =====================================================================
#  区域 [B]：底层逻辑静态库 (对应 src/shared/CMakeLists.txt)
#  注意：静态库不需要配置 QtQuick/QML，仅链接需要的 Qt 基础组件
# =====================================================================
# add_library(gy_shared STATIC
#     protocol.h
#     data_types.h
#     frame_codec.h
#     frame_codec.cpp
# )
# target_include_directories(gy_shared PUBLIC .)
# target_compile_features(gy_shared    PUBLIC cxx_std_23)
# target_link_libraries(gy_shared      PUBLIC Qt6::Core Qt6::Network)


# =====================================================================
#  区域 [C]：应用构建与 QML 模块注册 (对应 src/client/CMakeLists.txt)
#  处理界面文件的打包、C++ 类型的 QML 注册、以及链接底层库
# =====================================================================
qt_add_executable(app<<PROJECT_NAME>>  WIN32)
qt_add_qml_module(app<<PROJECT_NAME>>
    URI         "<<URI_DOTTED>>"
    VERSION     1.0
    SOURCES     
        main.cpp
        # 追加的业务 C++ 源码放置在此：
        # core/app_controller.h
        # core/app_controller.cpp
    QML_FILES   
        Main.qml
        # 追加的 QML 组件放置在此：
        # ui/DeviceCard.qml
)

target_compile_features(app<<PROJECT_NAME>> PRIVATE cxx_std_23)
target_link_libraries(app<<PROJECT_NAME>>
    PRIVATE 
        Qt6::Quick
        Qt6::QuickControls2
        Qt6::Network
        # 链接底层静态库以实现协议与接口共享：
        # gy_shared
)

target_include_directories(app<<PROJECT_NAME>> PRIVATE core)

set(CMAKE_INSTALL_PREFIX "/opt/${PROJECT_NAME}" CACHE PATH "Install path prefix" FORCE)
install(TARGETS app<<PROJECT_NAME>>
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
)

# ---- C++ Modules 支持（仅纯逻辑库可用，含 Q_OBJECT 的类禁用）----
set(<<PROJECT_NAME_UPPER>>_MODULE_FILES
    # math.cppm                              # 模块文件
)
source_group("<<PROJECT_NAME>>" FILES ${<<PROJECT_NAME_UPPER>>_MODULE_FILES})
target_sources(app<<PROJECT_NAME>>
    PRIVATE FILE_SET cxx_modules TYPE CXX_MODULES
        BASE_DIRS   ${CMAKE_CURRENT_SOURCE_DIR}
        FILES       ${<<PROJECT_NAME_UPPER>>_MODULE_FILES}
)
