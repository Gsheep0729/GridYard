# =====================================================================
#  GridYard Widgets-only 项目 CMake 样板
#  与团队作业 (Qt-Software-Group7) 同款风格
#  对应规范：GY-CS-002 §二
#
#  使用方法：
#    1. 复制为项目根目录的 CMakeLists.txt
#    2. 把所有 <<PROJECT_NAME>> 替换为实际项目名
#    3. SOURCES 列表按实际增减
#
#  红线提醒：
#    - 维护时优先 target_sources / target_link_libraries 增量追加
#    - 不要为方便而整体重写本文件
#    - Qt MOC 不识别 C++23 Module 语法，cxx_modules FILE_SET 仅供
#      与 Qt 无交叉的纯逻辑库使用
# =====================================================================

cmake_minimum_required(VERSION 4.2.3)

set(CMAKE_EXPERIMENTAL_CXX_IMPORT_STD "d0edc3af-4c50-42ea-a356-e2862fe7a444")
set(CMAKE_CXX_MODULE_STD ON)
function(_qt_add_executable target)
    qt_add_executable(${target})
endfunction()

project(<<PROJECT_NAME>> VERSION 0.1 LANGUAGES CXX)

find_package(Qt6 REQUIRED COMPONENTS Widgets)
qt_standard_project_setup()

_qt_add_executable(<<PROJECT_NAME>>)

target_compile_features(<<PROJECT_NAME>> PRIVATE cxx_std_23)

target_sources(<<PROJECT_NAME>>
    PRIVATE FILE_SET cxx_modules TYPE CXX_MODULES FILES
        # birds.cppm           # C++23 模块文件（仅纯逻辑库可用）
    PRIVATE
        main.cpp
        # widget.cpp
        # widget.h
        # widget.ui
)

# source_group("birds" FILES birds.cppm)

target_link_libraries(<<PROJECT_NAME>>
    PRIVATE
        Qt6::Widgets
)

set_target_properties(<<PROJECT_NAME>> PROPERTIES
    AUTORCC TRUE
    WIN32_EXECUTABLE TRUE
)

include(GNUInstallDirs)
set(CMAKE_INSTALL_PREFIX "/opt/${PROJECT_NAME}" CACHE PATH "Install path prefix" FORCE)
install(TARGETS <<PROJECT_NAME>>
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
)

qt_generate_deploy_app_script(
    TARGET <<PROJECT_NAME>>
    OUTPUT_SCRIPT deploy_script
    NO_UNSUPPORTED_PLATFORM_ERROR
)
install(SCRIPT ${deploy_script})
